{
  "name": "@pulse/workers",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/local-runner.ts",
    "start": "tsx --env-file-if-exists=../../.env src/local-runner.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.699.0",
    "@pulse/core": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
