{
  "name": "@pulse/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/bootstrap.js",
  "types": "dist/bootstrap.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    },
    "./lambda": {
      "default": "./dist/lambda.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@codegenie/serverless-express": "^4.16.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@pulse/core": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nestjs-pino": "^4.4.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.12",
    "@swc/core": "^1.10.7",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.6"
  }
}
