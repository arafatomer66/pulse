# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3100
LOG_LEVEL=debug

# --- AWS ---------------------------------------------------------------
AWS_REGION=ap-south-1
# Local-only: dummy credentials satisfy the SDK signer against DynamoDB Local / ElasticMQ.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Endpoint overrides. Leave BLANK in AWS — the SDK resolves real endpoints.
DYNAMODB_ENDPOINT=http://localhost:8102
SQS_ENDPOINT=http://localhost:9324

PULSE_TABLE=pulse-main
QUEUE_URL_PREFIX=http://localhost:9324/000000000000

# --- Channel providers -------------------------------------------------
# email: ses | smtp (smtp = MailHog locally)
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@pulse.local
SMTP_HOST=localhost
SMTP_PORT=1125

# push: fcm | log   (log = record the payload, send nothing — used until FCM creds land)
PUSH_PROVIDER=log
# FCM_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json

# sms: sns | bulksmsbd | log
SMS_PROVIDER=log
SMS_SENDER_ID=PULSE
# BULKSMSBD_API_KEY=
# BULKSMSBD_SENDER_ID=

# --- Limits ------------------------------------------------------------
DEFAULT_MONTHLY_QUOTA=100000
DEFAULT_RATE_LIMIT_PER_MIN=600
MESSAGE_RETENTION_DAYS=90

# Platform admin token guarding /admin/v1/*. Required (>=32 chars) in production.
ADMIN_TOKEN=local-dev-admin-token-change-me-0000
